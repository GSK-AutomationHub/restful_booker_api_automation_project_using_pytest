{
    "$schema": "https://json-schema.org/draft/2019-09/schema",
    "$id": "http://example.com/example.json",
    "type": "object",
    "default": {},
    "title": "Root Schema",
    "required": [
        "firstname",
        "lastname",
        "totalprice",
        "depositpaid",
        "bookingdates",
        "additionalneeds"
    ],
    "properties": {
        "firstname": {
            "type": "string",
            "default": "",
            "title": "The firstname Schema",
            "examples": [
                "Jim"
            ]
        },
        "lastname": {
            "type": "string",
            "default": "",
            "title": "The lastname Schema",
            "examples": [
                "Brown"
            ]
        },
        "totalprice": {
            "type": "integer",
            "default": 0,
            "title": "The totalprice Schema",
            "examples": [
                525
            ]
        },
        "depositpaid": {
            "type": "boolean",
            "default": false,
            "title": "The depositpaid Schema",
            "examples": [
                false
            ]
        },
        "bookingdates": {
            "type": "object",
            "default": {},
            "title": "The bookingdates Schema",
            "required": [
                "checkin",
                "checkout"
            ],
            "properties": {
                "checkin": {
                    "type": "string",
                    "default": "",
                    "title": "The checkin Schema",
                    "examples": [
                        "2025-02-10"
                    ]
                },
                "checkout": {
                    "type": "string",
                    "default": "",
                    "title": "The checkout Schema",
                    "examples": [
                        "2025-02-15"
                    ]
                }
            },
            "examples": [{
                "checkin": "2025-02-10",
                "checkout": "2025-02-15"
            }]
        },
        "additionalneeds": {
            "type": "string",
            "default": "",
            "title": "The additionalneeds Schema",
            "examples": [
                "Parking"
            ]
        }
    },
    "examples": [{
        "firstname": "Jim",
        "lastname": "Brown",
        "totalprice": 525,
        "depositpaid": false,
        "bookingdates": {
            "checkin": "2025-02-10",
            "checkout": "2025-02-15"
        },
        "additionalneeds": "Parking"
    }]
}